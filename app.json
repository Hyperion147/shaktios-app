{
  "expo": {
    "name": "ShaktiOS",
    "slug": "shaktios-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "shaktios-app",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#6468F0",
        "monochromeImage": "./assets/images/adaptive-icon.png"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      ["expo-secure-store", { "faceIDPermission": false }],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow ShaktiOS to scan event QR codes.",
          "recordAudioAndroid": false,
          "microphonePermission": "Allow ShaktiOS to record an optional voice report."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow ShaktiOS to attach your location to incident reports.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "motionUsagePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash.png",
          "imageWidth": 96,
          "resizeMode": "contain",
          "backgroundColor": "#F6F7F9"
        }
      ],
      "expo-status-bar",
      [
        "expo-audio",
        {
          "microphonePermission": "Allow ShaktiOS to record an optional voice report.",
          "recordAudioAndroid": true,
          "enableBackgroundRecording": false,
          "enableBackgroundPlayback": false
        }
      ]
    ],
    "extra": {
      "apiUrl": "http://10.0.2.2:8000"
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}
