# ShaktiOS backend base URL (FastAPI, default port 8000).
#
# Web / emulator on this machine:
EXPO_PUBLIC_API_URL=http://localhost:8000
#
# Physical phone over Wi-Fi (localhost on the phone is NOT this machine):
# 1. Find this machine's LAN IP, e.g. PowerShell:
#      Get-NetIPAddress -AddressFamily IPv4 | Where-Object { $_.IPAddress -notlike "127.*" }
# 2. Use: EXPO_PUBLIC_API_URL=http://<LAN_IP>:8000
#    where <LAN_IP> is YOUR machine's address from step 1.
#    Never commit a real IP — keep the <LAN_IP> placeholder in this file and
#    put the real address only in your local (gitignored) .env.
# 3. Phone and machine must be on the same Wi-Fi. Restart `pnpm dev`
#    after changing this file (Expo injects EXPO_PUBLIC_* at bundle time).
#    The backend must listen on 0.0.0.0, not 127.0.0.1.

# Supabase project URL (public; used for Supabase Auth).
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Supabase publishable key (safe for clients). NEVER the service-role key.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
